---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Tony Adragna">
  <section class="page-hero" style="min-height:50vh;">
    <div class="wrap">
      <p class="eyebrow"><span class="kicker-line"></span>Airball</p>
      <h1>404: Page <span style="color:var(--orange)">Not Found</span></h1>
      <p>That page doesn't exist (or moved when the site got its makeover). Let's run it back.</p>
      <div class="cta-row" style="margin-top:2rem; display:flex; gap:1rem;">
        <a class="btn" href="/">Back home</a>
        <a class="btn ghost" href="/blog/">Read the blog</a>
      </div>
    </div>
  </section>
</BaseLayout>
