---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import home from '../data/home.json';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

// Escape HTML, then turn **word** into an emphasis tag.
// In the CMS, wrapping a word in ** highlights it (orange in stats, bold in the tagline).
const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const em = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<em>$1</em>');
const bold = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<b>$1</b>');
---

<BaseLayout title="Tony Adragna | Business Leader | Basketball Coach | Husband & Dad">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow"><span class="kicker-line"></span>{home.hero.eyebrow}</p>
      <h1>Tony <span class="accent">Adragna</span></h1>
      <p class="tagline" set:html={bold(home.hero.tagline)} />
      <p class="lede" set:html={em(home.hero.lede)} />
      <div class="cta-row">
        <a class="btn" href="/blog/">Read the Blog</a>
        <a class="btn ghost" href="/about/">My Story</a>
      </div>
    </div>
  </section>

  <!-- SCOREBOARD -->
  <section class="scoreboard" aria-label="Highlights">
    <div class="wrap">
      {home.stats.map((stat) => (
        <div class="stat">
          <div class="num" set:html={em(stat.headline)} />
          <div class="label">{stat.detail}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- THE COACH -->
  <section class="section" id="coach">
    <div class="wrap">
      <p class="eyebrow"><span class="kicker-line"></span>The Coach</p>
      <h2>{home.coach.heading}</h2>
      <div class="two-col">
        <div>
          {home.coach.paragraphs.map((p, i) => (
            <p class="lead" style={i > 0 ? 'margin-top:1.25rem;' : undefined} set:html={em(p)} />
          ))}
        </div>
        <div class="card">
          <h3>{home.coach.timeline_title}</h3>
          <ul class="roster">
            {home.coach.timeline.map((item) => (
              <li>
                <span class="jersey">{item.year}</span>
                <div>
                  <div class="name">{item.name}</div>
                  <div class="role">{item.role}</div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="banner">
        <div class="trophy">🏆</div>
        <div>
          <div class="title">{home.coach.banner_title}</div>
          <div class="sub">{home.coach.banner_sub}</div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE LEADER -->
  <section class="section" id="leader">
    <div class="wrap">
      <p class="eyebrow"><span class="kicker-line"></span>The Business Leader</p>
      <h2>{home.leader.heading}</h2>
      {home.leader.paragraphs.map((p, i) => (
        <p class="lead" style={i > 0 ? 'margin-top:1.25rem;' : undefined} set:html={em(p)} />
      ))}
      <div class="card-grid">
        {home.leader.cards.map((card) => (
          <div class="card"><h3>{card.title}</h3><p>{card.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- THE FAMILY -->
  <section class="section" id="family">
    <div class="wrap">
      <p class="eyebrow"><span class="kicker-line"></span>The Family</p>
      <h2>{home.family.heading}</h2>
      <div class="two-col">
        <div>
          {home.family.paragraphs.map((p, i) => (
            <p class="lead" style={i > 0 ? 'margin-top:1.25rem;' : undefined} set:html={em(p)} />
          ))}
        </div>
        <div class="card">
          <h3>{home.family.roster_title}</h3>
          <ul class="roster">
            {home.family.roster.map((member) => (
              <li>
                <span class="jersey">{member.number}</span>
                <div>
                  <div class="name">{member.name}</div>
                  <div class="role">{member.role}</div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  <section class="section" id="blog">
    <div class="wrap">
      <p class="eyebrow"><span class="kicker-line"></span>From the Blog</p>
      <h2>Notes on leadership</h2>
      <p class="lead">Lessons from the gym, the office, and everywhere in between.</p>
      <div class="post-grid">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.id}/`}>
            <div class="meta">
              <span class="cat">{post.data.category}</span>
              <span>{fmt(post.data.date)}</span>
            </div>
            <h3>{post.data.title}</h3>
            {post.data.description && <p>{post.data.description}</p>}
            <span class="read">Read post →</span>
          </a>
        ))}
      </div>
      <div style="margin-top:2.5rem;">
        <a class="btn ghost" href="/blog/">All posts</a>
      </div>
    </div>
  </section>
</BaseLayout>
