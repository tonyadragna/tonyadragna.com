---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title="Blog | Tony Adragna" description="Tony Adragna's notes on leadership, coaching, and business.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow"><span class="kicker-line"></span>The Blog</p>
      <h1>Notes on <span style="color:var(--orange)">Leadership</span></h1>
      <p>Lessons from the gym, the office, and everywhere in between.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="post-grid">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.id}/`}>
            <div class="meta">
              <span class="cat">{post.data.category}</span>
              <span>{fmt(post.data.date)}</span>
            </div>
            <h3>{post.data.title}</h3>
            {post.data.description && <p>{post.data.description}</p>}
            <span class="read">Read post →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
