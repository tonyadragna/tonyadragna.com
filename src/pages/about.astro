---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'about');
if (!page) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(page);

// In the CMS, wrapping a word in ** makes it orange in the headline.
const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const em = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<em>$1</em>');
---

<BaseLayout title="My Story | Tony Adragna" description="Husband, dad of three, SVP of Operations at Keyholder Vacations, and head boys' basketball coach at Greenwood Christian Academy.">
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow"><span class="kicker-line"></span>My Story</p>
      <h1 set:html={em(page.data.title)} />
      {page.data.intro && <p>{page.data.intro}</p>}
    </div>
  </section>

  <article class="prose">
    <Content />
  </article>
</BaseLayout>
